# Variables d'environnement publiques (NEXT_PUBLIC_*).
# Inlinées au build par Next.js → visibles côté client (donc OK pour des IDs
# publics comme un measurement ID GA4 ou un code Search Console).
#
# ⚠️  NE PAS METTRE ici de secret réel (mdp, clé privée, token API).
# Pour les vrais secrets côté serveur, voir public/api/config.php (gitignoré).

# Google Analytics 4 — chargé uniquement après consentement cookies
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PDQJWW4H7S

# Google Search Console — vide ici car la vérification est faite par DNS TXT
# (couvre tout le domaine, pas besoin de balise HTML).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
