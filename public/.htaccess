# Agence Kinome — configuration Apache pour site Next.js statique
# (sert les HTML générés + maintient PHP actif pour /api/contact.php)

RewriteEngine On

# Forcer HTTPS (ceinture + bretelles, Hostinger fait déjà ça normalement)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canoniser sur le domaine sans www (cohérent avec sitemap.xml + canonical URLs)
RewriteCond %{HTTP_HOST} ^www\.agence-kinome\.ch [NC]
RewriteRule ^(.*)$ https://agence-kinome.ch/$1 [L,R=301]

# ============================================================================
# SÉCURITÉ — Interdire l'accès direct aux librairies PHP internes
# Le dossier /api/lib/ (PHPMailer & co) ne doit jamais être servi : on n'expose
# ni le code source ni la version des librairies (surface d'attaque CVE).
# /api/contact.php (endpoint du formulaire) reste public ; config.php est déjà
# verrouillé plus bas via FilesMatch.
# ============================================================================
RewriteRule ^api/lib/ - [F,L]

# ============================================================================
# REDIRECTIONS 301 — ancien WordPress → nouvelle structure Next.js
# Conserve le SEO accumulé par l'ancien site (Google transfère le jus
# d'indexation via les 301 permanentes).
# ============================================================================

# Pages projets : /microclimat/ → /projets/microclimat/ (etc.)
RewriteRule ^codecircle/?$            /projets/codecircle/          [L,R=301]
RewriteRule ^adapt-project/?$         /projets/adapt-project/       [L,R=301]
RewriteRule ^cabinet-faraday/?$       /projets/cabinet-faraday/     [L,R=301]
RewriteRule ^alministratif/?$         /projets/alministratif/       [L,R=301]
RewriteRule ^authentik-peak/?$        /projets/authentik-peak/      [L,R=301]
RewriteRule ^la-voyagiste/?$          /projets/la-voyagiste/        [L,R=301]
RewriteRule ^cinars/?$                /projets/cinars/              [L,R=301]
RewriteRule ^black-sheep-valley/?$    /projets/black-sheep-valley/  [L,R=301]
RewriteRule ^microclimat/?$           /projets/microclimat/         [L,R=301]
RewriteRule ^elips/?$                 /projets/elips/               [L,R=301]
RewriteRule ^le-ravenala/?$           /projets/le-ravenala/         [L,R=301]

# Projets récents (ajoutés post-migration) — anciens slugs WP qui retournaient
# 404 et faisaient remonter "Introuvable (404)" dans Search Console.
RewriteRule ^causerie-bot/?$          /projets/causerie-bot/        [L,R=301]
RewriteRule ^causeriebot/?$           /projets/causerie-bot/        [L,R=301]
RewriteRule ^lea-vigier/?$            /projets/lea-vigier/          [L,R=301]
RewriteRule ^leavigier/?$             /projets/lea-vigier/          [L,R=301]
RewriteRule ^manaloa/?$               /projets/manaloa/             [L,R=301]
RewriteRule ^mana-loa/?$              /projets/manaloa/             [L,R=301]
RewriteRule ^mana-loa-formations/?$   /projets/manaloa/             [L,R=301]
RewriteRule ^vp-conseils/?$           /projets/vp-conseils/         [L,R=301]
RewriteRule ^vpconseils/?$            /projets/vp-conseils/         [L,R=301]
RewriteRule ^no-code/?$               /projets/no-code/             [L,R=301]
RewriteRule ^nocode/?$                /projets/no-code/             [L,R=301]
RewriteRule ^nocode-ia/?$             /projets/no-code/             [L,R=301]
RewriteRule ^no-code-ia/?$            /projets/no-code/             [L,R=301]
RewriteRule ^nocodeia/?$              /projets/no-code/             [L,R=301]

# Pages principales renommées
RewriteRule ^nos-services/?$          /services/                    [L,R=301]
RewriteRule ^nos-partenaires/?$       /partenaires/                 [L,R=301]
RewriteRule ^processus-client/?$      /processus/                   [L,R=301]
RewriteRule ^homepage/?$              /                             [L,R=301]

# Anciens slugs d'articles de blog (WordPress avait un slug bizarre pour celui-ci)
RewriteRule ^agence-kinome-ch-blog-creation-site-internet-geneve-guide/?$  /blog/creation-site-internet-geneve-guide/  [L,R=301]
# Variante préfixée /blog/ du même slug malformé (404 vu dans GSC « Page en double »)
RewriteRule ^blog/agence-kinome-ch-blog-creation-site-internet-geneve-guide/?$  /blog/creation-site-internet-geneve-guide/  [L,R=301]

# Anciennes pages publiques /blog/{slug} qui étaient à la racine pendant la migration
RewriteRule ^choisir-agence-communication-geneve/?$           /blog/choisir-agence-communication-geneve/           [L,R=301]
RewriteRule ^creer-identite-visuelle-entreprise-geneve/?$    /blog/creer-identite-visuelle-entreprise-geneve/    [L,R=301]
RewriteRule ^creation-logo-geneve-processus/?$               /blog/creation-logo-geneve-processus/               [L,R=301]
RewriteRule ^tarifs-agence-communication-geneve/?$           /blog/tarifs-agence-communication-geneve/           [L,R=301]
RewriteRule ^creation-site-internet-geneve-guide/?$          /blog/creation-site-internet-geneve-guide/          [L,R=301]

# Anciennes pages de proposition / cas client (peuvent rester 410 Gone ou
# rediriger vers /portfolio/ — on choisit le portfolio pour ne pas frustrer
# d'éventuels visiteurs qui les avaient bookmarkées)
RewriteRule ^proposition-proxycore/?$  /portfolio/                  [L,R=301]
RewriteRule ^retour-graphiplus/?$      /portfolio/                  [L,R=301]

# WordPress feed / xmlrpc (Google les avait peut-être indexés)
RewriteRule ^feed/?$                /sitemap.xml                    [L,R=301]
RewriteRule ^xmlrpc\.php$           /                               [L,R=410]

# Index par défaut
DirectoryIndex index.html index.php

# Page 404 personnalisée (Next.js produit /404/index.html via App Router)
ErrorDocument 404 /404.html

# Compression GZIP (gain de bande passante)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# Cache long sur les assets immuables (Next.js fingerprint /_next/static/)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 month"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/javascript         "access plus 1 month"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/font-woff   "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
</IfModule>

# Cache immutable pour les bundles fingerprinted Next.js (1 an)
<IfModule mod_headers.c>
  <FilesMatch "\.(woff|woff2|jpg|jpeg|png|gif|webp|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # EXCEPTION : favicons (favicon.ico, icon.png, apple-icon.png) — NE PAS
  # mettre en cache immutable. Ces fichiers gardent un nom fixe (Next.js
  # n'ajoute pas de hash dans le filename, juste un query-string), donc
  # si on les met en cache long, les navigateurs (et Google !) gardent
  # l'ancien favicon WP indéfiniment. On force max-age 1h + revalidation
  # pour qu'un nouveau favicon se propage rapidement.
  <FilesMatch "^(favicon\.ico|icon\.png|apple-icon\.png|apple-touch-icon.*\.png|favicon-[0-9]+x[0-9]+\.png|android-chrome-[0-9]+x[0-9]+\.png)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Cache HTML : court (5 min) + revalidation stale-while-revalidate (1 sem)
  # → CWV-friendly + revalidation rapide après push
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # Sitemap + robots : cache 1h
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options    "nosniff"
  Header set X-Frame-Options           "SAMEORIGIN"
  Header set Referrer-Policy           "strict-origin-when-cross-origin"
  Header set Permissions-Policy        "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # CSP (Content Security Policy) — protège contre les injections XSS.
  # Autorise :
  #   - notre domaine + assets locaux (default-src 'self')
  #   - styles/scripts inline générés par Next.js ('unsafe-inline' nécessaire
  #     pour les <script> JSON-LD et les styles inline Tailwind)
  #   - Google Analytics (gtag) + Tag Manager
  #   - CauserieBot widget
  #   - data: et blob: pour les fonts/images embarquées
  Header set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://dashboard.causeriebot.com; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    img-src 'self' data: blob: https: ; \
    font-src 'self' data: https://fonts.gstatic.com; \
    media-src 'self'; \
    connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://dashboard.causeriebot.com wss://dashboard.causeriebot.com; \
    frame-src 'self' https://dashboard.causeriebot.com; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self'; \
    upgrade-insecure-requests"
</IfModule>

# Verrouille les fichiers sensibles (config PHP, dotfiles, etc.)
<FilesMatch "^(\.htaccess|\.htpasswd|\.env.*|config\.php|composer\..*|package.*\.json|.*\.lock|README\.md|DEPLOYMENT\.md)$">
  Require all denied
</FilesMatch>

# Forcer le bon Content-Type pour sitemap.xml et OG image
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/png .png
</IfModule>
