# Agence Kinome — configuration Apache pour site Next.js statique
# (sert les HTML générés + maintient PHP actif pour /api/contact.php)

RewriteEngine On

# Forcer HTTPS (ceinture + bretelles, Hostinger fait déjà ça normalement)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canoniser sur le domaine sans www (cohérent avec sitemap.xml + canonical URLs)
RewriteCond %{HTTP_HOST} ^www\.agence-kinome\.ch [NC]
RewriteRule ^(.*)$ https://agence-kinome.ch/$1 [L,R=301]

# Index par défaut
DirectoryIndex index.html index.php

# Page 404 personnalisée (Next.js produit /404/index.html via App Router)
ErrorDocument 404 /404.html

# Compression GZIP (gain de bande passante)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# Cache long sur les assets immuables (Next.js fingerprint /_next/static/)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 month"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/javascript         "access plus 1 month"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/font-woff   "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
</IfModule>

# Cache immutable pour les bundles fingerprinted Next.js (1 an)
<IfModule mod_headers.c>
  <FilesMatch "\.(woff|woff2|jpg|jpeg|png|gif|webp|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache HTML : court (5 min) + revalidation stale-while-revalidate (1 sem)
  # → CWV-friendly + revalidation rapide après push
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # Sitemap + robots : cache 1h
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options    "nosniff"
  Header set X-Frame-Options           "SAMEORIGIN"
  Header set Referrer-Policy           "strict-origin-when-cross-origin"
  Header set Permissions-Policy        "geolocation=(), microphone=(), camera=()"
</IfModule>

# Verrouille les fichiers sensibles (config PHP, dotfiles, etc.)
<FilesMatch "^(\.htaccess|\.htpasswd|\.env.*|config\.php|composer\..*|package.*\.json|.*\.lock|README\.md|DEPLOYMENT\.md)$">
  Require all denied
</FilesMatch>

# Forcer le bon Content-Type pour sitemap.xml et OG image
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/png .png
</IfModule>
